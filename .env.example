# GymAI Oracle VM production environment
# Copy to /home/ubuntu/apps/gymai/.env and fill every required value.

GYMAI_HTTP_PORT=4001
GHCR_NAMESPACE=your-github-username
IMAGE_TAG=latest-or-a-commit-sha

POSTGRES_DB=gym_ai
POSTGRES_USER=gymai
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
JPA_DDL_AUTO=update

REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

RABBITMQ_USERNAME=gymai
RABBITMQ_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

GOOGLE_CLIENT_ID=REPLACE
GOOGLE_CLIENT_SECRET=REPLACE
GITHUB_CLIENT_ID=REPLACE
GITHUB_CLIENT_SECRET=REPLACE

GMAIL_USERNAME=REPLACE
GMAIL_APP_PASSWORD=REPLACE
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

FRONTEND_URL=https://gymai.neelahouse.cloud
FRONTEND_ALLOWED_URLS=https://gymai.neelahouse.cloud

# Required only when GHCR packages are private.
GHCR_USERNAME=your-github-username
GHCR_PAT=REPLACE_WITH_READ_PACKAGES_PAT
